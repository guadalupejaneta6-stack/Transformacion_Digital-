def promedio_notas(notas):
    """
    Función que calcula el promedio de una lista de notas.

    Parámetros:
    notas: lista de números.

    Retorna:
    promedio de las notas.
    """

    total = sum(notas)
    cantidad = len(notas)

    promedio = total / cantidad

    return promedio


lista_notas = [9, 8, 10, 7, 8]

resultado = promedio_notas(lista_notas)

print("El promedio obtenido es:", resultado)
```
